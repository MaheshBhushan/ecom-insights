# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# Warehouse connection string used by src.utils.get_db_connection().
# Local Postgres (see docker-compose.yml for the container this points at):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce

# Azure SQL (documented cloud target; not executed in this project -- the
# project's Azure subscription is disabled). Requires the "ODBC Driver 18 for
# SQL Server" and pyodbc installed:
# DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>.database.windows.net:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server

LOG_LEVEL=INFO
