FROM python:3.13-slim
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
COPY src ./src
RUN useradd --uid 10001 --create-home briefing && mkdir /state && chown briefing /state
USER briefing
ENV DELIVERY_DB=/state/deliveries.sqlite3
EXPOSE 8000
CMD ["uvicorn", "src.delivery_api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
